  "audit_program": "python3 - <<'PY'\nimport pathlib,json,re,hashlib,shlex\nbase=pathlib.Path('benchmarks/electro')\ncost=json.loads((base/'m8-openloris-atlas-source-cost-v1.json').read_text())\ncoverage=json.loads((base/'m8-openloris-source-command-coverage-v1.json').read_text())['audit']['executions']\nrows=[]\nfor log,g in cost['execution_deduplicated_accounting']['by_log'].items():\n p=pathlib.Path(log);raw=p.read_bytes();s=raw.decode()\n assert hashlib.sha256(raw).hexdigest()==g['log_sha256']\n ranges=re.findall(r'rig-replay frame range: start=(\\d+) count=(\\d+)',s)\n source='mapper-log'\n if not ranges:\n  for record in coverage[log]['command_records']:\n   for line in record['lines']:\n    tokens=shlex.split(line.split('Command being timed: \"',1)[1][:-1])\n    if '--frame-range-start' in tokens and '--frame-range-count' in tokens:\n     ranges.append((tokens[tokens.index('--frame-range-start')+1],tokens[tokens.index('--frame-range-count')+1]))\n     source='recorded-time-command'\n ranges=sorted(set((int(a),int(b)) for a,b in ranges))\n rows.append({'log':log,'log_sha256':g['log_sha256'],'nodes':g['nodes'],'input_ranges':ranges,'range_source':source if ranges else None,'original_models':{str(n):cost['complete_audit']['matched_nodes'][str(n)]['images'] for n in g['nodes']}})\nprint(json.dumps({'executions':rows,'execution_count':len(rows),'node_count':sum(len(r['nodes']) for r in rows),'unknown_ranges':[r['log'] for r in rows if len(r['input_ranges'])!=1]}))\nPY",
