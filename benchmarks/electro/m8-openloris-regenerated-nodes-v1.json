  "audit_program": "python3 - <<'PY'\nimport pathlib,json,re,hashlib\nbase=pathlib.Path('benchmarks/electro');mapping={}\nfor f in sorted(list(base.glob('m8-openloris-source-spec-*-v1.json'))+list(base.glob('m8-openloris-source-replay-*-v1.json'))):\n e=json.loads(f.read_text());p=e['audit_program']\n old=re.search(r\"old=pathlib.Path\\('([^']+)'\\)\",p).group(1)\n root=re.search(r\"root=pathlib.Path\\('([^']+)'\\)\",p).group(1)\n assert old not in mapping\n mapping[old]=(pathlib.Path(root)/'model',str(f))\ninventory=json.loads((base/'m8-openloris-source-execution-inventory-v1.json').read_text())['audit']['executions']\nby_node={str(n):(row['original_models'][str(n)],row['log']) for row in inventory for n in row['nodes']}\nsource=pathlib.Path('/home/sasaki/datasets/openloris/corridor1-1-m8-atlas-landmarks-v1/nodes.tsv')\nout=[];rows=[]\nfor line in source.read_text().splitlines():\n if not line or line.startswith('#'):out.append(line);continue\n node,offset,image=line.split('\\t')\n original,log=by_node[node];op=pathlib.Path(original);oldroot=op.parent.parent\n newroot,evidence=mapping[str(oldroot)];newimage=newroot/op.relative_to(oldroot)\n hashes={}\n for name in ['cameras.txt','images.txt','points3D.txt']:\n  a=newimage.parent/name;b=pathlib.Path(image).parent/name\n  ha=hashlib.sha256(a.read_bytes()).hexdigest();hb=hashlib.sha256(b.read_bytes()).hexdigest()\n  assert ha==hb,(node,name)\n  hashes[name]=ha\n out.append('\\t'.join([node,offset,str(newimage)]))\n rows.append({'node':int(node),'offset':int(offset),'images':str(newimage),'evidence':evidence,'hashes':hashes})\nassert len(rows)==23 and len(mapping)==21\nprint(json.dumps({'nodes_tsv':'\\n'.join(out)+'\\n','rows':rows,'original_nodes_sha256':hashlib.sha256(source.read_bytes()).hexdigest()}))\nPY",
