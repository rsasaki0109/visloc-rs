diff --git a/mast3r_slam/evaluate.py b/mast3r_slam/evaluate.py
index c5605b1..3bb02d7 100644
--- a/mast3r_slam/evaluate.py
+++ b/mast3r_slam/evaluate.py
@@ -87,0 +88,47 @@ def save_keyframes(savedir, timestamps, keyframes: SharedKeyframes):
+def save_state_npz(filename, keyframes: SharedKeyframes, selected_frame_ids=None):
+    """Export optimized poses and selected canonical pointmaps for auditing."""
+    selected = None if selected_frame_ids is None else set(selected_frame_ids)
+    frame_ids = []
+    sim3_data = []
+    pointmap_frame_ids = []
+    pointmaps = []
+    confidences = []
+    image_shapes = []
+    for i in range(len(keyframes)):
+        keyframe = keyframes[i]
+        frame_ids.append(keyframe.frame_id)
+        sim3_data.append(keyframe.T_WC.data.detach().cpu().numpy().reshape(-1))
+        if selected is not None and keyframe.frame_id not in selected:
+            continue
+        X_canon = keyframe.X_canon
+        if config["use_calib"]:
+            X_canon = constrain_points_to_ray(
+                keyframe.img_shape.flatten()[:2], X_canon[None], keyframe.K
+            ).squeeze(0)
+        pointmap_frame_ids.append(keyframe.frame_id)
+        pointmaps.append(X_canon.detach().cpu().numpy())
+        confidences.append(keyframe.get_average_conf().detach().cpu().numpy())
+        image_shapes.append(keyframe.img_shape.detach().cpu().numpy().reshape(-1))
+
+    if selected is not None and set(pointmap_frame_ids) != selected:
+        missing = sorted(selected - set(pointmap_frame_ids))
+        raise RuntimeError(f"requested export frames were not keyframes: {missing}")
+
+    filename = pathlib.Path(filename)
+    filename.parent.mkdir(exist_ok=True, parents=True)
+    np.savez_compressed(
+        filename,
+        frame_ids=np.asarray(frame_ids, dtype=np.int64),
+        sim3=np.asarray(sim3_data, dtype=np.float32),
+        pointmap_frame_ids=np.asarray(pointmap_frame_ids, dtype=np.int64),
+        pointmaps=np.asarray(pointmaps, dtype=np.float32),
+        confidences=np.asarray(confidences, dtype=np.float32),
+        image_shapes=np.asarray(image_shapes, dtype=np.int64),
+        intrinsics=(
+            keyframes.get_intrinsics().detach().cpu().numpy()
+            if config["use_calib"]
+            else np.empty((0, 0), dtype=np.float32)
+        ),
+    )
+
+
